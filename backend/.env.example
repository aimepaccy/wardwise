# Copy this file to .env and fill in the values. Never commit .env.

# AI provider (any OpenAI-compatible API)
LLM_BASE_URL=https://api.groq.com/openai/v1
# A local server (for example Ollama) needs no real key: any non-empty value works.
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Tokens per minute allowed by the provider's plan (Groq free tier: 8000). Material up to about a third of
# this is written in one go; longer sessions are condensed first and take a few minutes.
LLM_TOKENS_PER_MINUTE=8000
# For reasoning models (low, medium, high). Leave empty for providers or models that do not support it.
LLM_REASONING_EFFORT=low
# The smaller model that condenses long sessions into notes, with its own allowance (Groq free tier: 8000).
# Leave the model empty to use LLM_MODEL for the notes too.
CONDENSE_MODEL=openai/gpt-oss-20b
CONDENSE_TOKENS_PER_MINUTE=8000

# Speech-to-text. Leave the URL and key empty to use the same provider as above.
TRANSCRIBE_BASE_URL=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-large-v3-turbo

# A model that can read images, for photos of handwritten notes (same provider as the LLM)
VISION_MODEL=qwen/qwen3.8-27b

# Front-end addresses allowed to call the API (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173

# Largest request the server accepts, in MB (25 MB of audio and five 15 MB photos, with room to spare)
MAX_REQUEST_MB=110

# Further reading
# YouTube Data API v3 key (free, 10,000 units a day; WardWise uses about 80). In Google Cloud, restrict it to
# the YouTube Data API v3. Left empty, the videos are left out and everything else still works.
YOUTUBE_API_KEY=
# Optional NCBI key for PubMed and StatPearls: 10 requests a second instead of 3.
NCBI_API_KEY=

# Hosted demo protection. Left empty (as on your own computer), no code is asked for. On a hosted copy, set a
# code of three or more random words joined by hyphens (plain letters and digits only, so every browser can send it),
# and give it only to people you demo to; the page asks for it once and remembers it. With a code set, the API's
# documentation pages (/docs) are switched off.
ACCESS_CODE=
# Per address, in any one hour: requests that start AI work, and further reading searches (0 means no limit).
JOBS_PER_HOUR=40
READING_PER_HOUR=120
# The most jobs in progress at once, across everyone; more are told WardWise is busy (0 means no limit).
MAX_ACTIVE_JOBS=4
